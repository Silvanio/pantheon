# Copy to .env and adjust for local development.
# Used by infra/docker-compose.yml and referenced by each service's application.yml.

# --- pantheon-service database ---
SERVICE_DB_NAME=pantheon_service
SERVICE_DB_USER=pantheon
SERVICE_DB_PASSWORD=pantheon

# --- pantheon-message database ---
MESSAGE_DB_NAME=pantheon_message
MESSAGE_DB_USER=pantheon
MESSAGE_DB_PASSWORD=pantheon

# --- RabbitMQ (shared broker, used by both Java services) ---
RABBITMQ_USER=pantheon
RABBITMQ_PASSWORD=pantheon

# --- Service-to-service API token (pantheon-service -> pantheon-message) ---
PANTHEON_API_TOKEN=dev-shared-api-token

# --- pantheon-service base URL, used by pantheon-message context / callbacks if needed ---
PANTHEON_MESSAGE_BASE_URL=http://localhost:8082

# --- JWT signing secret used by pantheon-service to issue session tokens ---
PANTHEON_JWT_SECRET=dev-jwt-signing-secret-change-me-please-32bytes

# --- Google OAuth2 client credentials for pantheon-service login ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Object storage (MinIO locally, any S3-compatible service in other environments) ---
# used by pantheon-service to store daily report photos/videos/attachments as files, never
# as database rows — see add-daily-report-media-and-signoff's design.md "Storage key layout".
STORAGE_ROOT_USER=pantheon
STORAGE_ROOT_PASSWORD=pantheon-secret
PANTHEON_STORAGE_ENDPOINT=http://minio:9000
PANTHEON_STORAGE_REGION=us-east-1
PANTHEON_STORAGE_BUCKET=pantheon
PANTHEON_STORAGE_ACCESS_KEY=pantheon
PANTHEON_STORAGE_SECRET_KEY=pantheon-secret

# --- pantheon-web ---
VITE_PANTHEON_SERVICE_URL=http://localhost:8081
