# Vite environment modes — Local / Dev / PRD
#
# This project uses three mode-specific env files, mapped onto Vite's own conventions instead of
# fighting them:
#
#   .env.development  Local tier. Vite's own default mode for `npm run dev` (no --mode flag).
#                      Must NOT set VITE_SENTRY_DSN — Local never sends errors to Sentry.
#   .env.dev           Dev tier. A custom Vite mode, built via `npm run build:dev`
#                      (`vite build --mode dev`). Sets VITE_SENTRY_DSN to the real DSN.
#   .env.production    PRD tier. Vite's own default mode for `npm run build`. Sets
#                      VITE_SENTRY_DSN to the real DSN.
#
# IMPORTANT: do NOT create a file named `.env.local` to represent the "Local" tier. Vite treats
# `.env.local` as a special always-loaded override file layered on top of EVERY mode (and it's
# gitignored by Vite's own default .gitignore template) — it is not mode-specific despite the
# name. Naming the Local tier's file `.env.local` would silently leak its values (or absence of
# a Sentry DSN) into Dev/PRD builds too, or vice versa. Use `.env.development` instead.
#
# This file (.env.example) documents the variables; it is not itself loaded by Vite.

VITE_PANTHEON_SERVICE_URL=http://localhost:8081

# Sentry DSN for error tracking (see openspec/changes/add-sentry-error-tracking).
# Leave unset/blank in .env.development (Local). Set to the real DSN in .env.dev and
# .env.production — a Sentry DSN is a semi-public identifier (like a Firebase Web API key),
# not a secret, and Vite bakes VITE_-prefixed vars into the client bundle at build time
# regardless, so there is no meaningful way to keep it out of a built artifact anyway.
VITE_SENTRY_DSN=
